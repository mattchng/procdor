{
  "manifest_version": 3,
  "name": "Procdor — Prompt Condenser",
  "version": "0.1.0",
  "description": "Condenses verbose prompts before you send them to Claude. Rule-based, no API calls — testing and using it costs zero extra tokens.",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["lib/compress.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Procdor rule settings"
  }
}
